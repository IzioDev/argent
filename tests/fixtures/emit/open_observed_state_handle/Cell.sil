pragma silverscript ^0.1.0;

contract Cell(byte[32] init_agent_covid, byte[32] init_agent_type, int init_tick) {
    struct AgentCapsule {
        byte[32] controller_id;
        byte[32] caps_digest;
        int energy;
    }

    byte[32] agent_covid = init_agent_covid;

    byte[32] agent_type = init_agent_type;

    int tick = init_tick;

    entry advance(int gen__actor_type_self_agent_type_prefix_len, int gen__actor_type_self_agent_type_suffix_len) {
        byte[32] gen__remote_cov_id = agent_covid;
        require(OpCovInputCount(gen__remote_cov_id) == 1);
        require(OpCovOutputCount(gen__remote_cov_id) == 1);
        int gen__remote_agent_input_idx = OpCovInputIdx(gen__remote_cov_id, 0);
        AgentCapsule gen__remote_agent_state = readInputStateWithTemplate(gen__remote_agent_input_idx, gen__actor_type_self_agent_type_prefix_len, gen__actor_type_self_agent_type_suffix_len, agent_type);
        int gen__remote_agent_output_idx = OpCovOutputIdx(gen__remote_cov_id, 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__cell_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        AgentCapsule prev_state = gen__remote_agent_state;
        require(prev_state.controller_id == OpInputCovenantId(this.activeInputIndex));
        AgentCapsule next_state = AgentCapsule {controller_id: prev_state.controller_id, caps_digest: prev_state.caps_digest, energy: prev_state.energy - 1};
        validateOutputStateWithInputTemplate(gen__remote_agent_output_idx, next_state, gen__remote_agent_input_idx, gen__actor_type_self_agent_type_prefix_len, gen__actor_type_self_agent_type_suffix_len, agent_type);
        State next_cell = State {agent_covid: agent_covid, agent_type: agent_type, tick: tick + 1};
        validateOutputState(gen__cell_output_idx, next_cell);
    }
}
