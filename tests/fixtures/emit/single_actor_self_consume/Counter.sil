pragma silverscript ^0.1.0;

contract Counter(int init_count) {
    int count = init_count;

    function global_identity(State gen__glob_value): State {
        return(gen__glob_value);
    }

    function actor_identity(State value): State {
        return(global_identity(value));
    }

    entry merge() {
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 2);
        require(OpCovInputIdx(gen__cov_id, 0) == this.activeInputIndex);
        int gen__other_input_idx = OpCovInputIdx(gen__cov_id, 1);
        State gen__other_state = readInputState(gen__other_input_idx);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(OpCovOutputCount(gen__cov_id) == OpAuthOutputCount(this.activeInputIndex));
        State copied = actor_identity(global_identity(gen__other_state));
        copied = global_identity(gen__other_state);
        State next_state = State {count: count + copied.count};
        require(gen__other_state.count >= 0);
        validateOutputState(gen__next_output_idx, next_state);
    }

    entry hold() {
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(count >= 0);
    }
}
