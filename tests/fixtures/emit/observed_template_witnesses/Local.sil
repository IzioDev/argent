pragma silverscript ^0.1.0;

contract Local(byte[32] gen__init_foreign_template, byte[32] init_target_id) {
    struct ForeignState {
        int count;
    }

    struct LocalState {
        byte[32] target_id;
    }

    byte[32] gen__foreign_template = gen__init_foreign_template;

    byte[32] target_id = init_target_id;

    entry step(int gen__foreign_prefix_len, int gen__foreign_suffix_len) {
        byte[32] gen__asset_cov_id = target_id;
        require(OpCovInputCount(gen__asset_cov_id) == 1);
        require(OpCovOutputCount(gen__asset_cov_id) == 1);
        int gen__asset_src_input_idx = OpCovInputIdx(gen__asset_cov_id, 0);
        ForeignState gen__asset_src_state = readInputStateWithTemplate(gen__asset_src_input_idx, gen__foreign_prefix_len, gen__foreign_suffix_len, gen__foreign_template);
        int gen__asset_dst_output_idx = OpCovOutputIdx(gen__asset_cov_id, 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        ForeignState prev = gen__asset_src_state;
        ForeignState next = ForeignState {count: prev.count + 1};
        validateOutputStateWithInputTemplate(gen__asset_dst_output_idx, next, gen__asset_src_input_idx, gen__foreign_prefix_len, gen__foreign_suffix_len, gen__foreign_template);
    }
}
