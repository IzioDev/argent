pragma silverscript ^0.1.0;

contract Foreign(byte[32] gen__init_target_template, int init_amount) {
    struct ForeignState {
        int amount;
    }

    struct LocalState {
        byte[32] foreign_id;
        int steps;
    }

    struct TargetState {
        int units;
    }

    byte[32] gen__target_template = gen__init_target_template;

    int amount = init_amount;

    function add_one(int gen__glob_value): int {
        return(gen__glob_value + 1);
    }

    function amount_is_valid(): bool {
        return(amount >= 0);
    }

    function route_units(): int {
        return(0);
    }

    entry hold() {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(amount_is_valid());
        require(tx.outputs[gen__next_output_idx].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);
    }

    entry route(byte[] gen__target_prefix, byte[] gen__target_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        TargetState next_state = TargetState {units: route_units()};
        validateOutputStateWithTemplate(gen__next_output_idx, next_state, gen__target_prefix, gen__target_suffix, gen__target_template);
    }
}
