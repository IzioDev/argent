pragma silverscript ^0.1.0;

contract Target(int init_units) {
    struct ForeignState {
        int amount;
    }

    struct LocalState {
        byte[32] foreign_id;
        int steps;
    }

    int units = init_units;

    function add_one(int gen__glob_value): int {
        return(gen__glob_value + 1);
    }

    function units_are_valid(): bool {
        return(units >= 0);
    }

    entry hold() {
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(units_are_valid());
    }
}
