pragma silverscript ^0.1.0;

contract Ticket(byte[32] init_owner, int init_serial, int init_redeemed) {
    struct IssuerState {
        byte[32] admin;
        int next_serial;
    }

    byte[32] owner = init_owner;

    int serial = init_serial;

    int redeemed = init_redeemed;

    entry redeem(sig owner_sig, pubkey owner_pk) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(blake2b(byte[](owner_pk)) == owner);
        require(checkSig(owner_sig, owner_pk));
        require(redeemed == 0);
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        State redeemed_ticket = State {owner: owner, serial: serial, redeemed: 1};
        validateOutputState(gen__next_output_idx, redeemed_ticket);
    }
}
