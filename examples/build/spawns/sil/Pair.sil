pragma silverscript ^0.1.0;

contract Pair(int init_amount) {
    struct ControllerState {
        byte[32] pair_type;
        int launches;
    }

    int amount = init_amount;

    entry keep() {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(tx.outputs[gen__next_output_idx].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);
    }
}
