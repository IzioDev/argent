pragma silverscript ^0.1.0;

contract Spectator(int init_ply) {
    struct LobbyState {
        int nonce;
    }

    struct ArchiveState {
        int final_ply;
    }

    int ply = init_ply;

    entry inspect() {
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(ply >= 0);
    }
}
