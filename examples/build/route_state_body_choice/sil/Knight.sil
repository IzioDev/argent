pragma silverscript ^0.1.0;

contract Knight(byte[32] gen__init_mux_template, byte[64] gen__init_mux_routes, int init_ply) {
    struct LobbyState {
        int nonce;
    }

    struct BoardState {
        int ply;
    }

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[64] gen__mux_routes = gen__init_mux_routes;

    int ply = init_ply;

    entry inspect() {
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(ply >= 1);
    }
}
